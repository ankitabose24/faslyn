# ==============================================================================
# Faslyn — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# xAI Grok API Key (Get yours from https://console.x.ai/)
XAI_API_KEY=xai-your-grok-api-key-here
GROK_API_KEY=xai-your-grok-api-key-here

# Faslyn Backend REST API Port
FASLYN_API_PORT=8000

# Streamlit Frontend Port
FASLYN_PORT=8501

# Environment mode
ENVIRONMENT=development
